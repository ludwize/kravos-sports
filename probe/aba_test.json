/* ABA League sponsor footer | Bootstrap 3.3.7 | no JavaScript */
.aba-footer,.aba-footer *{box-sizing:border-box}
.aba-footer{background:#222222;color:#e7e8ea;padding:38px 0 34px;font-size:14px}
.aba-footer__inner{max-width:1700px;margin:0 auto;padding:0 28px}
.aba-footer__section+.aba-footer__section{margin-top:24px}
.aba-footer__heading{display:flex;align-items:center;gap:18px;margin:0 0 16px;color:#d8dade;text-transform:uppercase;font-size:16px;line-height:1.4;font-weight:800;white-space:nowrap}
.aba-footer__heading:after{content:"";height:2px;background:#505358;flex:1}
.aba-footer__logos{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));align-items:center}
.aba-footer__logo{height:100px;display:flex;justify-content:center;align-items:center;padding:12px 24px;border-right:2px solid #505358;text-decoration:none;position:relative;transition:background-color .25s ease}
.aba-footer__logo:hover,.aba-footer__logo:focus{background:rgba(255,255,255,.055);text-decoration:none}
.aba-footer__logos>.aba-footer__logo:last-child{border-right:0}
.aba-footer__logo-images{display:block;position:relative;width:100%;height:76px}
.aba-footer__logo-images img{position:absolute;inset:0;margin:auto;display:block;max-width:100%;max-height:100%;width:auto;height:auto;object-fit:contain;transition:opacity .25s ease,transform .25s ease}
.aba-footer__logo-white{opacity:1}
.aba-footer__logo-color{opacity:0}
.aba-footer__logo:hover .aba-footer__logo-white,.aba-footer__logo:focus .aba-footer__logo-white{opacity:0}
.aba-footer__logo:hover .aba-footer__logo-color,.aba-footer__logo:focus .aba-footer__logo-color{opacity:1;transform:scale(1.045)}
.aba-footer__logo--ball{height:96px;max-width:280px;margin:0 auto;border:0}
.aba-footer a:focus-visible{outline:2px solid #fff;outline-offset:3px}
/* Tablet: 2 + 3 */
@media (min-width:601px) and (max-width:1100px){
 .aba-footer__logos{grid-template-columns:repeat(6,minmax(0,1fr));row-gap:12px}
 .aba-footer__logos>.aba-footer__logo:nth-child(-n+2){grid-column:span 3}
 .aba-footer__logos>.aba-footer__logo:nth-child(n+3){grid-column:span 2}
 .aba-footer__logos>.aba-footer__logo:nth-child(2),
 .aba-footer__logos>.aba-footer__logo:nth-child(5){border-right:0}
}
/* XS: 1 + 2 + 2 */
@media (max-width:600px){
 .aba-footer{padding:28px 0}
 .aba-footer__inner{padding:0 18px}
 .aba-footer__heading{font-size:14px;margin-bottom:12px}
 .aba-footer__logos{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px 0}
 .aba-footer__logo{height:76px;padding:7px 12px}
 .aba-footer__logo-images{height:55px}
 .aba-footer__logos>.aba-footer__logo:first-child{grid-column:1/-1;justify-self:center;width:50%;border-right:0}
 .aba-footer__logos>.aba-footer__logo:nth-child(3),
 .aba-footer__logos>.aba-footer__logo:nth-child(5){border-right:0}
 .aba-footer__logos>.aba-footer__logo:nth-child(4){border-right:2px solid #505358}
 .aba-footer__logo--ball{max-width:220px;width:100%;height:76px}
}
@media(prefers-reduced-motion:reduce){.aba-footer__logo,.aba-footer__logo-images img{transition:none}}

</style>


